<section class="tab {{tab.cssClass}} jj2-page jj2-summary jj2-npc-summary" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="jj2-combat-metrics">
    <div class="jj2-metric jj2-metric-resistance">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="con"}}<strong>{{system.attributes.ac.value}}</strong><span class="jj2-metric-label">Classe de Resistência</span>{{#if editable}}<button type="button" class="jj2-config" data-action="showConfiguration" data-config="armorClass" aria-label="Configurar Classe de Resistência">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="config"}}</button>{{/if}}</div>
    <div class="jj2-metric jj2-metric-movement">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="dex"}}<strong>{{jj2.movement.value}} <small>{{jj2.movement.unit}}</small></strong><span class="jj2-metric-label">{{#if jj2.movement.voando}}Voo{{else}}Movimento{{/if}}</span>{{#if editable}}<button type="button" class="jj2-config" data-action="showConfiguration" data-config="movement" aria-label="Configurar Movimento">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="config"}}</button>{{/if}}</div>
    <button type="button" class="jj2-metric jj2-metric-initiative {{rollableClass}} {{#if owner}}always-interactive{{/if}}" data-action="roll" data-type="initiative" aria-label="Rolar Iniciativa" {{disabled (not owner)}}>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}<strong>{{dnd5e-formatModifier system.attributes.init.total}}</strong><span class="jj2-metric-label">Iniciativa</span></button>
    <div class="jj2-metric jj2-engagement">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="cha"}}{{#if editable}}<input type="number" name="system.legacy2.engagement" value="{{jj2.engagementBase}}" min="0" data-dtype="Number" placeholder="{{jj2.engagement}}" aria-label="Engajamento">{{else}}<strong>{{jj2.engagement}}</strong>{{/if}}<span class="jj2-metric-label">Engajamento</span></div>
  </div>
  <div class="jj2-panel jj2-npc-classification"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="summary"}}Perfil da Ameaça</h2>
    {{#if editable}}<div class="jj2-npc-fields">
      <label>Classificação<select name="system.legacy2.categoria" aria-label="Classificação de Existência">{{#each jj2.npc.categories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div><p class="jj2-npc-note">Crie os itens de Taxonomia e Arquétipo na lista de Itens e arraste para esta ficha. Eles aparecem como tags abaixo do nome; clique na tag para editar o perfil aplicado.</p>{{/if}}
    <p class="jj2-npc-note">Classificação de Existência: <strong>{{jj2.npc.category}}</strong> · {{jj2.npc.classificationHp}}× PV · {{jj2.npc.classificationActions}} Pontos de Ação por rodada.</p>
    {{#if jj2.npc.distribution}}<div class="jj2-npc-distribution"><header><strong>20 iniciais <span>+ {{jj2.npc.distribution.growthPoints}} por ND</span></strong><span>{{jj2.npc.distribution.budget}} pontos</span></header><div class="jj2-npc-distribution-values">{{#each jj2.npc.distribution.rows}}<div title="Inicial {{initial}} + crescimento {{growth}}"><span>{{localize label}}</span><strong>{{initial}}<small> +{{growth}}</small></strong></div>{{/each}}</div>{{#if jj2.npc.distribution.unspent}}<p>{{jj2.npc.distribution.unspent}} ponto(s) de crescimento não aplicado(s). Confira o Arquétipo e o limite de 12 por atributo.</p>{{/if}}</div>{{else}}{{#if jj2.npc.archetype}}<p class="jj2-npc-note">Arraste um item de Taxonomia para distribuir os 20 pontos iniciais e aplicar o crescimento do Arquétipo.</p>{{/if}}{{/if}}
    {{#if itemCategories.classes}}<div class="jj2-npc-profile jj2-npc-styles">{{#each itemCategories.classes}}<button type="button" class="jj2-action always-interactive item-tooltip" data-action="showDocument" data-item-id="{{id}}" data-uuid="{{uuid}}"><img src="{{img}}" alt="">{{name}}</button>{{/each}}</div>{{/if}}
    {{#if editable}}<details class="jj2-npc-native-details"><summary>Dados da criatura</summary><div class="jj2-npc-fields"><label>Tamanho<select name="system.traits.size">{{selectOptions CONFIG.actorSizes selected=source.traits.size labelAttr="label"}}</select></label><label>Tipo<button type="button" class="jj2-action" data-action="showConfiguration" data-config="creatureType">{{system.details.type.label}}{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="config"}}</button></label><label>Alinhamento<input type="text" name="system.details.alignment" value="{{source.details.alignment}}"></label></div></details>{{else}}<p class="jj2-npc-note">{{lookup (lookup CONFIG.actorSizes system.traits.size) "label"}} {{system.details.type.label}} {{system.details.alignment}}</p>{{/if}}
  </div>
  {{#if editable}}<div class="jj2-panel jj2-npc-energy-settings"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}Configuração de Energia</h2><div class="jj2-npc-fields"><label>Reserva máxima{{#if jj2.npc.hasTaxonomy}}<strong>{{system.energy.max}}</strong>{{else}}<input type="number" name="system.energy.max" value="{{source.energy.max}}" min="0" data-dtype="Number">{{/if}}</label><label>Limite de Refinada<input type="number" name="system.energy.genMax" value="{{source.energy.genMax}}" min="0" data-dtype="Number"></label><label>Refinada por turno<input type="number" name="system.energy.genPerTurn" value="{{source.energy.genPerTurn}}" min="0" data-dtype="Number"></label></div></div>{{/if}}
  <div class="jj2-panel jj2-npc-armor"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="con"}}Proteção</h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-resource.hbs" id="armor" label="Pontos de Armadura" path="system.armorPoints.value" value=system.armorPoints.value max=system.armorPoints.max pct=jj2.npc.armorPct configKey="armorPoints"}}
    {{#if editable}}<div class="jj2-npc-temp-fields"><label>Vida temporária<input type="number" name="system.attributes.hp.temp" value="{{source.attributes.hp.temp}}" min="0" data-dtype="Number"></label><label>Ajuste de Vida máxima<input type="number" name="system.attributes.hp.tempmax" value="{{source.attributes.hp.tempmax}}" data-dtype="Number"></label></div>{{/if}}
  </div>
  <div class="jj2-panel jj2-saves"><div class="jj2-saves-heading"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="con"}}Salvaguardas</h2></div><ul>
    {{#each jj2.saves}}<li class="jj2-rank-row" data-key="{{key}}" data-ability="{{key}}"><div class="jj2-rank-name">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key=key}}<a class="saving-throw {{@root.rollableClass}}" data-action="roll" data-type="ability">{{label}}</a></div><div class="jj2-rank-line">{{> "systems/jujutsu-system/templates/actors/parts/jj2-ranks.hbs" ctx="saves"}}<strong>{{dnd5e-formatModifier total}}</strong></div><small>{{rankLabel}}</small></li>{{/each}}
  </ul></div>
  {{> "systems/jujutsu-system/templates/actors/parts/jj2-resistances.hbs" }}
  {{#if showDeathSaves}}<div class="jj2-panel jj2-npc-death"><h2><button type="button" class="jj2-action always-interactive" data-action="roll" data-type="deathSave">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="dice"}}Teste de Morte</button></h2><div class="jj2-npc-temp-fields"><label>Sucessos<input type="number" name="system.attributes.death.success" value="{{system.attributes.death.success}}" min="0" max="3" data-dtype="Number"></label><label>Falhas<input type="number" name="system.attributes.death.failure" value="{{system.attributes.death.failure}}" min="0" max="3" data-dtype="Number"></label></div></div>{{/if}}
  {{#if showLoyalty}}<div class="jj2-panel"><h2>Lealdade</h2>{{#if editable}}<input type="number" name="system.attributes.loyalty.value" value="{{source.attributes.loyalty.value}}" data-dtype="Number" aria-label="Lealdade">{{else}}<strong>{{system.attributes.loyalty.value}}</strong>{{/if}}</div>{{/if}}
  {{#if (or editable hasLegendaries)}}<div class="jj2-panel jj2-npc-legendary"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}Recursos Lendários</h2><div class="jj2-npc-fields">{{#each jj2.npc.legendaries}}<div class="jj2-npc-legendary-group"><strong>{{label}}</strong>{{#if @root.editable}}<span class="jj2-npc-legendary-inputs"><input type="number" name="system.resources.{{key}}.spent" value="{{spent}}" min="0" max="{{max}}" data-dtype="Number" aria-label="{{label}} gastos"><span>/</span><input type="number" name="system.resources.{{key}}.max" value="{{max}}" min="0" data-dtype="Number" aria-label="Máximo de {{label}}"></span><small>Gastos / Máximo</small>{{else}}<strong>{{value}} / {{max}}</strong><div class="pips" data-prop="system.resources.{{key}}.spent">{{#each (lookup @root key)}}<button type="button" class="{{classes}} {{#if @root.owner}}always-interactive{{/if}}" data-action="togglePip" data-n="{{n}}" aria-label="{{localize label}}" aria-pressed="{{filled}}" {{disabled (not @root.owner)}}>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}</button>{{/each}}</div>{{/if}}</div>{{/each}}</div>
    {{#if editable}}<div class="jj2-npc-temp-fields">{{#if modernRules}}<label>Ações de Covil<input type="checkbox" name="system.resources.lair.value" {{checked source.resources.lair.value}}></label>{{else}}<label>Iniciativa de Covil<input type="number" name="system.resources.lair.initiative" value="{{source.resources.lair.initiative}}" data-dtype="Number"></label>{{/if}}<label>Dentro do Covil<input type="checkbox" name="system.resources.lair.inside" {{checked source.resources.lair.inside}}></label></div>{{else}}{{#if modernRules}}{{#if system.resources.lair.value}}<label class="jj2-npc-lair">Dentro do Covil<input type="checkbox" class="{{#if owner}}always-interactive{{/if}}" name="system.resources.lair.inside" {{checked system.resources.lair.inside}} {{disabled (not owner)}}></label>{{/if}}{{else}}{{#if system.resources.lair.initiative}}<p class="jj2-npc-note">Iniciativa de Covil: {{system.resources.lair.initiative}}</p>{{/if}}{{/if}}{{/if}}
  </div>{{/if}}
</section>
