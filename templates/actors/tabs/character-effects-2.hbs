<section class="tab {{ tab.cssClass }} jj2-page jj2-effects-page" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  <header class="jj2-page-heading jj2-manga-heading jj2-effects-heading"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="effects" }}Efeitos</h2><output aria-label="Total de efeitos">{{ jj2EffectsCount }}<small>efeitos</small></output></header>
  {{#if fulgorNegro}}
  <section class="jj2-fulgor-box" aria-labelledby="{{rootId}}-fulgor-title">
    <header class="jj2-fulgor-heading">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="fulgor" }}<div><h3 id="{{rootId}}-fulgor-title">Fulgor Negro</h3><span>Black Flash · Kokusen</span></div></header>
    <div class="jj2-fulgor-settings">
      <label for="{{rootId}}-fulgor-primary"><span>Margem principal</span><input id="{{rootId}}-fulgor-primary" type="number" name="flags.jujutsu-system.fulgorPrimaria" value="{{fulgorPrimaria}}" min="1" max="20" step="1" class="{{#if owner}}always-interactive{{/if}}" {{disabled (not owner)}}><small>Resultado natural mínimo do ataque</small></label>
      <label for="{{rootId}}-fulgor-secondary"><span>Margem secundária</span><input id="{{rootId}}-fulgor-secondary" type="number" name="flags.jujutsu-system.fulgorSecundaria" value="{{fulgorSecundaria}}" min="1" max="20" step="1" class="{{#if owner}}always-interactive{{/if}}" {{disabled (not owner)}}><small>Resultado mínimo do dado secundário</small></label>
    </div>
    <p class="jj2-fulgor-hint">As margens vão de 1 a 20. Fulgor Certeiro garante uma margem secundária de 11 ou menor.</p>
    <div class="jj2-fulgor-controls">
      <button type="button" class="jj2-fulgor-testar {{#if owner}}always-interactive{{/if}}" data-action="jj-fulgor-testar" {{disabled (not owner)}}>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="dice" }}Testar Kokusen (1d20)</button>
      <button type="button" class="jj2-fulgor-zona {{#if fulgorZona}}active{{/if}} {{#if owner}}always-interactive{{/if}}" data-action="jj-fulgor-zona" {{disabled (not owner)}}>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="energy" }}<span data-fulgor-zone-label>{{#if fulgorZona}}Desativar Zona{{else}}Ativar Zona{{/if}}</span></button>
    </div>
  </section>
  {{/if}}
  {{> "dnd5e.active-effects" }}
</section>
