<aside class="sidebar jj2-sidebar" aria-label="Ações e favoritos">
  <button type="button" class="sidebar-collapser always-interactive" data-action="toggleSidebar" aria-expanded="{{#if sidebarCollapsed}}false{{else}}true{{/if}}" aria-label="{{#if sidebarCollapsed}}Expandir sidebar{{else}}Recolher sidebar{{/if}}">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="collapse" }}</button>
  {{> "systems/jujutsu-system/templates/actors/parts/jj2-sidebar-actions.hbs"}}
  <section class="jj2-ed-card">
    <button type="button" class="jj2-ed-btn {{#if owner}}always-interactive{{/if}}" data-action="jj2ExplosaoDefensiva" {{ disabled (not owner) }} data-tooltip="{{#if jj2.isRestringido}}Impulso Físico — 1 PE = 2d4 de redução · limite {{jj2.impulsoLimite}} PE{{else}}Explosão Defensiva (padrão 2.0) — sempre d4 · limite {{ jj2.explosaoLimite }} dados (metade do nível){{/if}}">
      <span class="jj2-ed-head">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="con" }}<strong>{{#if jj2.isRestringido}}Impulso Físico{{else}}Explosão Defensiva{{/if}}</strong></span>
      <span class="jj2-ed-dice">{{#if jj2.isRestringido}}{{jj2.impulsoDados}}d4{{else}}{{#if jj2.explosaoLimite}}{{ jj2.explosaoLimite }}d4{{else}}—{{/if}}{{/if}}</span>
    </button>
  </section>
  <section class="jj2-favorites favorites"><h2>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="pin" }}Favoritos</h2><ul>
    {{#each favorites}}<li class="{{#if itemId}}item-tooltip{{/if}} {{ type }} {{#if draggable}}draggable{{/if}}" data-favorite-id="{{ id }}" {{#if key}}data-key="{{ key }}"{{/if}} {{#if itemId}}data-item-id="{{ itemId }}"{{/if}} {{#if effectId}}data-effect-id="{{ effectId }}"{{/if}} {{#if parentId}}data-parent-id="{{ parentId }}"{{/if}} {{#if activityId}}data-activity-id="{{ activityId }}"{{/if}} {{#if reference}}data-reference-tooltip="{{ reference }}"{{/if}} {{#if method}}data-method="{{ method }}"{{/if}} {{#if level}}data-level="{{ level }}"{{/if}}>
      <button type="button" class="jj2-favorite-name {{ rollableClass }} {{#if @root.owner}}always-interactive{{/if}}" data-action="useFavorite" {{ disabled (not @root.owner) }}>{{#if img}}<img src="{{ img }}" alt="">{{else}}{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="pin" }}{{/if}}<span><strong>{{ title }}</strong></span></button>
      {{#if @root.editable}}<button type="button" class="jj2-config" data-action="deleteFavorite" aria-label="Remover {{ title }} dos favoritos">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="close" }}</button>{{/if}}
    </li>{{else}}<li class="jj2-favorites-empty">Fixe técnicas e itens para acessá-los aqui.</li>{{/each}}
  </ul></section>
  <footer class="jj2-sidebar-footer"><span>Jujutsu Legacy</span><strong>2.0</strong></footer>
</aside>
