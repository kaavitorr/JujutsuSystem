<div class="jj2-dots" data-ctx="{{ ctx }}" data-key="{{ key }}" data-current-rank="{{ rank }}" role="group" aria-label="Proficiência em {{ label }}: {{ rankLabel }}">
  {{#each @root.jj2.rankDots as |dot|}}
  {{#if dot.rank}}<button type="button" class="jj2-dot {{#if (lte dot.rank ../rank)}}filled{{/if}} {{#if (eq dot.rank ../rank)}}selected{{/if}}" data-action="jj2Rank" data-rank="{{ dot.rank }}" data-tooltip="{{ dot.label }}{{#if (eq dot.rank ../rank)}} · Clique novamente para destreinar{{/if}}" aria-label="{{ dot.label }}" aria-pressed="{{#if (eq dot.rank ../rank)}}true{{else}}false{{/if}}" {{ disabled (not @root.editable) }}><span></span></button>{{/if}}
  {{/each}}
</div>
