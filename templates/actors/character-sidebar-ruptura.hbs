<aside class="sidebar jj2-sidebar" aria-label="Retrato e recursos do personagem">
  <button type="button" class="sidebar-collapser always-interactive" data-action="toggleSidebar" aria-expanded="{{#if sidebarCollapsed}}false{{else}}true{{/if}}" aria-label="{{#if sidebarCollapsed}}Expandir sidebar{{else}}Recolher sidebar{{/if}}">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="collapse" }}</button>
  <div class="jj2-portrait portrait {{#if portrait.token}}token{{/if}}">
    {{#if editable}}<label class="jj2-portrait-toggle"><input type="checkbox" name="flags.jujutsu-system.showTokenPortrait" {{ checked portrait.token }}>Usar imagem do token</label>{{/if}}
    {{#with portrait}}
      {{#if isVideo}}<video src="{{ src }}" autoplay muted loop playsinline disablepictureinpicture {{#if @root.editable}}data-action="{{ action }}"{{else}}data-action="showArtwork"{{/if}} {{#if (and @root.editable path)}}data-edit="{{ path }}" data-type="{{ type }}"{{/if}}></video>
      {{else}}<img src="{{ src }}" alt="{{ @root.actor.name }}" {{#if @root.editable}}data-action="{{ action }}"{{else}}data-action="showArtwork"{{/if}} {{#if (and @root.editable path)}}data-edit="{{ path }}" data-type="{{ type }}"{{/if}}>{{/if}}
    {{/with}}
  </div>
  <div class="jj2-sidebar-resources">
    {{> "systems/jujutsu-system/templates/actors/parts/jj2-resource.hbs" id="hp" label="Pontos de Vida" icon="heart" path="system.attributes.hp.value" value=system.attributes.hp.value max=system.attributes.hp.effectiveMax pct=jj2.hpPct configKey="hitPoints" }}
    {{> "systems/jujutsu-system/templates/actors/parts/jj2-resource.hbs" id="wounds" label="Ferimentos" icon="wounds" path="system.legacy2.wounds.value" value=jj2.wounds.value max=jj2.wounds.max pct=jj2.wounds.pct }}
    {{> "systems/jujutsu-system/templates/actors/parts/jj2-resource.hbs" id="energy" label="Energia Amaldiçoada" icon="energy" path="system.energy.total" value=system.energy.total max=system.energy.max pct=jj2.energyPct configKey="cursedEnergy" }}
    {{> "systems/jujutsu-system/templates/actors/parts/jj2-resource.hbs" id="refinement" label="Refinamento" path="system.energy.generated" value=jj2.energyAvailable max=jj2.refinement pct=jj2.refinementPct unbounded=true sigil=true action="jj-gerar-aura" actionLabel="Gerar energia do turno" hint="Energia disponível / limite da rodada" }}
    {{> "systems/jujutsu-system/templates/actors/parts/jj2-resource.hbs" id="actions" label="Pontos de Ação" path="system.legacy2.actions.value" value=jj2.actions.value max=jj2.actions.max pips=jj2.actions.pips pipsMode=true action="jj2RestoreActions" actionLabel=jj2.actions.restoreLabel }}
  </div>
  <div class="jj2-sidebar-stats">
    <div><span>Classe de Resistência</span><strong>{{ system.attributes.ac.value }}</strong></div>
    <div><button type="button" class="{{ rollableClass }} {{#if owner}}always-interactive{{/if}}" data-action="roll" data-type="initiative" aria-label="Rolar Iniciativa">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="energy" }}Iniciativa</button><strong>{{ dnd5e-formatModifier system.attributes.init.total }}</strong></div>
    <div><span>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="movement" }}Movimento</span><strong>{{ speed.value }} <small>{{ localize (lookup (lookup CONFIG.movementUnits system.attributes.movement.units) "abbreviation") }}</small></strong>{{#if editable}}<button type="button" class="jj2-config" data-action="showConfiguration" data-config="movement" aria-label="Configurar Movimento">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="config" }}</button>{{/if}}</div>
  </div>
</aside>
