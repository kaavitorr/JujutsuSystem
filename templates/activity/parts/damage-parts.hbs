{{#each damageParts}}
<fieldset class="unfieldset" {{ disabled locked }}>
    <div class="form-group split-group full-width card damage-part {{#if data.base}}base-part{{/if}}"
         data-index="{{ index }}">
        <div class="form-fields field-groups">
            {{> "systems/jujutsu-system/templates/activity/parts/damage-part.hbs" }}
        </div>
    </div>
</fieldset>
{{else}}
<div class="empty">
    {{{ localize "DND5E.DAMAGE.Empty" }}}
</div>
{{/each}}
{{#if (and (eq damageParts.length 1) damageParts.0.locked)}}
<div class="empty">
    {{{ localize "DND5E.DAMAGE.EmptyExceptBase" }}}
</div>
{{/if}}
