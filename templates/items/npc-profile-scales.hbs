<section class="tab {{tab.cssClass}} jj2-npc-scale" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <header class="jj2-scale-heading"><div><small>{{#if profile.taxonomy}}BASE DO NPC{{else}}EVOLUÇÃO DO NPC{{/if}}</small><h2>{{#if profile.taxonomy}}Taxonomia{{else}}Arquétipo{{/if}}</h2></div><strong data-scale-total>{{profile.total}} / 12</strong></header>
  <p class="jj2-scale-intro">{{#if profile.taxonomy}}A proporção abaixo distribui os 20 pontos iniciais. Cada atributo fica entre 1 e 12.{{else}}A proporção abaixo distribui +1 ponto por ND após o primeiro. Peso zero não recebe crescimento.{{/if}}</p>
  <div class="jj2-scale-grid">{{#each profile.attributes}}<label class="jj2-scale-attribute">{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key=key}}<span>{{label}}</span>{{#if @root.editable}}<input type="number" name="system.pesos.{{key}}" value="{{weight}}" data-npc-weight="{{key}}" min="0" max="12" step="1" required data-dtype="Number" aria-label="Peso de {{label}}">{{else}}<strong>{{weight}}</strong>{{/if}}</label>{{/each}}</div>
  <p class="jj2-scale-status" data-scale-status role="status">Escala completa</p>
  <section class="jj2-scale-preview"><header><h3>{{> "systems/jujutsu-system/templates/actors/parts/jj2-icon.hbs" key="summary"}}Prévia da distribuição</h3>{{#if profile.taxonomy}}<span>ND 1 · 20 pontos</span>{{else}}<label>ND <input type="number" value="13" min="1" max="100" step="1" data-preview-nd aria-label="ND da prévia"></label>{{/if}}</header><div class="jj2-scale-preview-values">{{#each profile.attributes}}<div><span>{{label}}</span><strong data-preview-ability="{{key}}">{{#unless @root.profile.taxonomy}}+{{/unless}}{{preview}}</strong></div>{{/each}}</div><p>{{#if profile.taxonomy}}Os pesos são proporções, não os valores finais dos atributos.{{else}}A prévia mostra somente os pontos adicionais. A base vem da Taxonomia. O teto continua sendo 12 por atributo.{{/if}}</p></section>
  {{#if profile.taxonomy}}<fieldset class="jj2-scale-energy"><legend>Energia da criatura</legend><label>Energia base por ND{{#if editable}}<input type="number" name="system.energiaBase" value="{{source.energiaBase}}" min="0" step="1" data-dtype="Number">{{else}}<strong>{{system.energiaBase}}</strong>{{/if}}</label><label>{{#if editable}}<input type="checkbox" name="system.vidaEnergia" {{checked source.vidaEnergia}}>{{else}}<input type="checkbox" {{checked system.vidaEnergia}} disabled>{{/if}}Espírito Amaldiçoado: Vida e Energia compartilham a reserva</label></fieldset>{{/if}}
  {{#if isEmbedded}}<p class="jj2-scale-copy-note">Esta é a cópia aplicada ao NPC. Alterações aqui recalculam sua ficha.</p>{{/if}}
</section>
